# Copie para .env.local e preencha com as credenciais do seu projeto Supabase.
# Painel: Project Settings > API. Nunca coloque aqui a service_role key —
# tudo que comeca com VITE_ vai para o bundle e fica visivel no navegador.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
